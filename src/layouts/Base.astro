---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import { SITE } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path including leading and trailing slash, e.g. "/contatti/". */
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/og-default.jpg',
  ogImageAlt = 'Studio Dentistico Taddia, dentista a Novara: la sala operativa dello studio',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(path, SITE).href;
const ogUrl = new URL(ogImage, SITE).href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#009A8E" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/fira-sans-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fira-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fira-sans-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Studio Dentistico Dott. Taddia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <WhatsAppWidget />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>

<style is:global>
  /* Keep the last content clear of the fixed mobile call bar. */
  @media (max-width: 47.99rem) {
    body {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
