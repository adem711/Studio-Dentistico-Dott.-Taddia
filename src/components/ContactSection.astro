---
import studio from '../data/studio.json';
import ContactForm from './ContactForm.astro';
import LocationMap from './LocationMap.astro';
import OpenNow from './OpenNow.astro';
import Icon from './Icon.astro';
import { hoursRows } from '../lib/hours';
import { whatsappHref } from '../lib/contact';
import Container from './Container.astro';

interface Props {
  /** The /contatti/ page has its own h1, so the section heading is an h2 either way; this only changes the eyebrow text. */
  showIntro?: boolean;
}
const { showIntro = true } = Astro.props;
---
{/* DEMO: section copy drafted; client to approve. The map (<LocationMap />) fills the space under the contact details, beside the form. */}
<section class="contact" id="contatti" aria-labelledby="contact-title">
  <Container class="contact__grid">
    <div class="contact__info">
      {showIntro && <p class="eyebrow reveal">Contatti</p>}
      <h2 id="contact-title" class="h1 reveal">Vieni a trovarci, <em>o chiamaci</em>.</h2>

      <ul class="facts">
        <li>
          <Icon name="pin" />
          <span>
            <strong>{studio.address.street}</strong>
            {studio.address.postalCode} {studio.address.city} ({studio.address.province})
          </span>
        </li>
        <li>
          <Icon name="whatsapp" />
          <span>
            <a href={whatsappHref()} target="_blank" rel="noopener" aria-label={`Scrivici su WhatsApp al ${studio.phone}`}><strong>{studio.phone}</strong></a>
            <span class="facts__alt">Scrivici su WhatsApp, oppure <a href={studio.phoneHref}>chiama</a>.</span>
          </span>
        </li>
        <li>
          <Icon name="clock" />
          <span>
            <strong>Orari</strong>
            <dl class="hours">
              {hoursRows().map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
            </dl>
            <OpenNow />
          </span>
        </li>
      </ul>
    </div>

    <div class="contact__form" id="appuntamento">
      <h3 class="h3">Richiedi un appuntamento</h3>
      <p>Lascia i tuoi recapiti: ti richiamiamo per fissare la visita.</p>
      <ContactForm />
    </div>

    <div class="contact__map">
      <LocationMap />
    </div>
  </Container>
</section>

<style>
  .contact {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2rem, 5vw, 4rem);
  }
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
    grid-template-areas:
      'info'
      'form'
      'map';
  }
  .contact__info {
    grid-area: info;
    display: grid;
    gap: 1.5rem;
  }
  .contact__form {
    grid-area: form;
  }
  .contact__map {
    grid-area: map;
  }
  .facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .facts li > :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.2rem;
    color: var(--color-teal-600);
  }
  .facts li > span {
    display: grid;
    gap: 0.35rem;
    font-size: 1.0625rem;
  }
  .facts strong {
    color: var(--color-graphite-800);
    font-weight: 500;
  }
  .facts a {
    text-decoration: none;
  }
  .facts .facts__alt {
    font-size: 0.9375rem;
    color: var(--color-graphite-600);
  }
  .facts .facts__alt a {
    text-decoration: underline;
  }
  .hours {
    display: grid;
    gap: 0.25rem;
    max-width: 20rem;
    margin: 0;
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .hours dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .contact__form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-teal-50);
    border-top: 4px solid var(--color-teal-500);
  }
  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      /* The form spans both rows; the map takes whatever height is left under the details, so both columns end level. */
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'info form'
        'map form';
      column-gap: clamp(3rem, 6vw, 6rem);
      row-gap: 2rem;
      align-items: stretch;
    }
    .contact__info {
      align-self: start;
    }
    /* The form box stretches to the height of the left column when that is taller, so the two always end level;
       its fields stay at the top and the spare room sits at the bottom of the box. */
    .contact__form {
      align-self: stretch;
      align-content: start;
    }
    .contact__map {
      min-height: 0;
    }
  }
</style>
