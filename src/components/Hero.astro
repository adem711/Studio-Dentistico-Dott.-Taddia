---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Container from './Container.astro';
import OpenNow from './OpenNow.astro';
import studio from '../data/studio.json';

interface Props {
  image: ImageMetadata;
  widths: number[];
  sizes: string;
}
const { image, widths, sizes } = Astro.props;
---
{/* DEMO: headline from the brand guidelines; lead text drafted. Client to approve wording (TODO-client.md section 4). */}
<section class="hero" aria-labelledby="hero-title">
  <Container class="hero__grid">
    <div class="hero__text">
      <p class="eyebrow rise i0">Studio dentistico a Novara</p>
      <h1 id="hero-title" class="display rise i1">
        Il sorriso di tutta la famiglia, <em>in&nbsp;buone&nbsp;mani</em>.
      </h1>
      <p class="lead rise i2">
        Visite senza fretta e piani di cura chiari, spiegati passo dopo passo, per adulti e bambini.
      </p>
      <div class="hero__cta rise i3">
        <a class="btn" href={studio.phoneHref}>
          <Icon name="phone" class="ring" />
          Chiama ora
        </a>
        <a class="btn btn--ghost" href="/contatti/#appuntamento">
          Richiedi un appuntamento
          <Icon name="arrow" class="nudge" />
        </a>
      </div>
      <div class="rise i4">
        <OpenNow />
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__square" aria-hidden="true"></div>
      <div class="hero__photo">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          alt="La sala operativa dello studio: poltrona odontoiatrica, lampada e ampie finestre luminose."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem);
    overflow-x: clip;
  }
  .hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hero__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 38rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Signature: the photo breaks out of the brand's teal square, as the tooth does in the logo. */
  .hero__media {
    position: relative;
    order: -1;
    width: 100%;
    aspect-ratio: 16 / 11;
  }
  .hero__square {
    position: absolute;
    top: 0;
    right: 0;
    width: 70%;
    height: 82%;
    background: var(--color-teal-500);
    animation: square-in 1.1s var(--ease-out-quart) 0.15s both;
  }
  .hero__photo {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 84%;
    height: 90%;
    overflow: hidden;
    background: var(--color-teal-50);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    transform-origin: 40% 70%;
    animation: ken-burns 26s ease-out both;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .hero__media {
      order: 0;
      max-width: 40rem;
      margin-left: auto;
      aspect-ratio: 1 / 1;
    }
    .hero__text {
      gap: 1.75rem;
    }
  }

  /* Entrance: transform and opacity only, and never on the photo (the LCP element). */
  .rise {
    animation: rise 0.9s var(--ease-out-quart) both;
    animation-delay: calc(var(--i, 0) * 90ms + 80ms);
  }
  .i0 { --i: 0; }
  .i1 { --i: 1; }
  .i2 { --i: 2; }
  .i3 { --i: 3; }
  .i4 { --i: 4; }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes square-in {
    from {
      transform: translate(-2.5rem, 2.5rem);
    }
    to {
      transform: none;
    }
  }
  @keyframes ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }
</style>
