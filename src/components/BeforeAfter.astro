---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
  label: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** Where to anchor the crop when a photo is not 16:10 (every frame is 16:10 so rows of cards stay even). */
  focus?: 'left' | 'center' | 'right' | 'top';
}
const { before, after, alt, label, sizes = '(min-width: 64rem) 46vw, 92vw', loading = 'lazy', focus = 'center' } = Astro.props;
---
<!--
  Before/after comparison. The range input is the real control (keyboard, screen reader, touch drag);
  src/scripts/before-after.ts only mirrors its value into --pos. Without JS it stays on the 50/50 split.
-->
<div class="ba" data-before-after data-focus={focus} role="group" aria-label={alt}>
  <div class="ba__frame">
    <Picture
      class="ba__img"
      src={after}
      formats={['avif', 'webp']}
      widths={[480, 720, 960]}
      sizes={sizes}
      alt=""
      loading={loading}
      decoding="async"
    />
    <Picture
      class="ba__img ba__img--before"
      src={before}
      formats={['avif', 'webp']}
      widths={[480, 720, 960]}
      sizes={sizes}
      alt=""
      loading={loading}
      decoding="async"
    />
    <span class="ba__chip ba__chip--before" aria-hidden="true">Prima</span>
    <span class="ba__chip ba__chip--after" aria-hidden="true">Dopo</span>
    <span class="ba__handle" aria-hidden="true"><span></span></span>
    <input
      class="ba__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={`${label}: sposta per confrontare prima e dopo`}
    />
  </div>
</div>

<style>
  .ba {
    --pos: 50%;
  }
  /* One fixed 16:10 frame for every case, so cards in a row are the same height whatever the source photo's shape. */
  .ba__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-graphite-100);
    touch-action: pan-y;
  }
  .ba__frame :global(picture),
  .ba__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ba__frame :global(.ba__img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .ba[data-focus='left'] .ba__frame :global(.ba__img) {
    object-position: 20% 50%;
  }
  .ba[data-focus='right'] .ba__frame :global(.ba__img) {
    object-position: 80% 50%;
  }
  .ba[data-focus='top'] .ba__frame :global(.ba__img) {
    object-position: 50% 15%;
  }
  /* "before" overlays "after", revealed from the left up to --pos. */
  .ba__frame :global(.ba__img--before) {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba__chip {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: rgb(20 40 38 / 0.82);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba__chip--before {
    left: 0.75rem;
  }
  .ba__chip--after {
    right: 0.75rem;
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--color-white);
    box-shadow: 0 0 0 1px rgb(20 40 38 / 0.25);
    pointer-events: none;
  }
  .ba__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    border-radius: 50%;
    background: var(--color-teal-600);
    border: 2px solid var(--color-white);
    box-shadow: 0 4px 14px -4px rgb(20 40 38 / 0.5);
    transition: transform 0.2s var(--ease-out-quart);
  }
  .ba__handle span::before,
  .ba__handle span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: -0.25rem;
    border-top: 2px solid var(--color-white);
    border-left: 2px solid var(--color-white);
  }
  .ba__handle span::before {
    left: 0.7rem;
    transform: rotate(-45deg);
  }
  .ba__handle span::after {
    right: 0.7rem;
    transform: rotate(135deg);
  }
  .ba:hover .ba__handle span {
    transform: scale(1.08);
  }
  /* Invisible range input covers the whole frame; drag anywhere. */
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    background: transparent;
  }
  .ba__range::-webkit-slider-thumb {
    appearance: none;
    width: 3rem;
    height: 100vh;
  }
  .ba__range::-moz-range-thumb {
    width: 3rem;
    height: 100vh;
    border: 0;
    background: transparent;
  }
  .ba__frame:has(.ba__range:focus-visible) {
    outline: 3px solid var(--color-teal-700);
    outline-offset: 3px;
  }
  .ba__frame:has(.ba__range:focus-visible) .ba__handle span {
    box-shadow: 0 0 0 4px var(--color-teal-100), 0 4px 14px -4px rgb(20 40 38 / 0.5);
  }
</style>

<script>
  import '../scripts/before-after.ts';
</script>
