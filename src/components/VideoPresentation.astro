---
import Icon from './Icon.astro';
import Container from './Container.astro';
---
{/* DEMO: section heading from the brief. The video is the clinic's own (Brand info/Video/videoplayback.mp4), published at the client's request; rights and consent of the person shown to be confirmed (TODO-client.md #19). */}
<section class="video on-dark" aria-labelledby="video-title">
  <Container>
    <header class="video__head reveal">
      <p class="eyebrow">Lo studio in video</p>
      <h2 id="video-title" class="h1">Presentazione dello <em>Studio Dentistico Taddia</em></h2>
      <p class="lead">Un tour guidato all'interno dei nostri spazi.</p>
    </header>

    <div class="video__frame reveal" data-video>
      <video
        controls
        playsinline
        preload="none"
        data-poster="/video/video-poster.jpg"
        width="1280"
        height="720"
        aria-describedby="video-note"
      >
        <source src="/video/presentazione-studio.mp4" type="video/mp4" />
        Il tuo browser non riesce a riprodurre il video.
        <a href="/video/presentazione-studio.mp4">Scarica il video</a>.
      </video>
      <button class="video__play" type="button" hidden aria-label="Avvia il video: Presentazione dello Studio Dentistico Taddia">
        <span class="video__ring" aria-hidden="true"></span>
        <Icon name="play" />
      </button>
    </div>
    <p class="video__note small" id="video-note">
      Durata circa 1 minuto e mezzo, con sottotitoli in italiano. Non parte da solo: l'audio si attiva solo se avvii il video.
    </p>
  </Container>
</section>

<style>
  .video {
    background: var(--color-ink);
    color: var(--color-graphite-300);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .video__head {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    max-width: 44rem;
    margin: 0 auto clamp(1.75rem, 4vw, 3rem);
    text-align: center;
  }
  .video__head h2 {
    color: var(--color-white);
  }
  .video__head .lead {
    color: var(--color-graphite-300);
  }
  .video__frame {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: #000;
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.8);
  }
  /* The brand's teal square, offset behind the frame (same device as the hero). */
  .video__frame::before {
    content: '';
    position: absolute;
    inset: auto 1.5rem -1rem auto;
    width: 38%;
    height: 38%;
    z-index: -1;
    background: var(--color-teal-600);
  }
  .video__frame video {
    display: block;
    width: 100%;
    height: 100%;
    background: #000;
    object-fit: cover;
  }
  .video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    padding: 0;
    border: 3px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-teal-600);
    color: var(--color-white);
    cursor: pointer;
    transition:
      transform 0.25s var(--ease-out-quart),
      background-color 0.2s;
  }
  .video__play:not([hidden]) {
    display: grid;
  }
  .video__play:hover {
    background: var(--color-teal-700);
    transform: scale(1.08);
  }
  .video__play:active {
    transform: scale(0.96);
  }
  .video__play :global(svg) {
    width: 2rem;
    height: 2rem;
    margin-left: 0.2rem;
    fill: currentColor;
    stroke: none;
  }
  /* Subtle pulse: a ring that grows and fades. Transform and opacity only. */
  .video__ring {
    position: absolute;
    inset: -3px;
    border: 2px solid var(--color-white);
    border-radius: 50%;
    animation: video-pulse 2.6s var(--ease-out-quart) infinite;
    pointer-events: none;
  }
  @keyframes video-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  .video__note {
    max-width: 62rem;
    margin: 1.25rem auto 0;
    color: var(--color-graphite-300);
    text-align: center;
  }
  @media (max-width: 47.99rem) {
    .video__frame::before {
      inset: auto 1rem -0.5rem auto;
    }
    .video__play {
      width: 4rem;
      height: 4rem;
      margin: -2rem 0 0 -2rem;
    }
  }
</style>

<script>
  import '../scripts/video.ts';
</script>
